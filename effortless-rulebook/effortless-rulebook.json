        "datatype": "string",
        "type": "raw",
        "nullable": false,
        "Description": "Op vocabulary: AddOptional, AddWithDefault, Remove, RequireToOptional, OptionalToRequire, EnumVersionBump, CoerceToEnum, UpgradeChild, UpgradeChildIf, UpgradeListItems, UpgradeListItemsIf, AddProjected, Custom."
      },
      {
        "name": "FieldName",
        "datatype": "string",
        "type": "raw",
        "nullable": true,
        "Description": "The attribute name being touched (most ops)."
      },
      {
        "name": "LiteralValue",
        "datatype": "string",
        "type": "raw",
        "nullable": true,
        "Description": "JSON-encoded literal default (AddWithDefault) or source field name (AddProjected)."
      },
      {
        "name": "FromVersion",
        "datatype": "string",
        "type": "raw",
        "nullable": true,
        "Description": "Source version for conditional upgrades (UpgradeChildIf, UpgradeListItemsIf)."
      },
      {
        "name": "ToVersion",
        "datatype": "string",
        "type": "raw",
        "nullable": true,
        "Description": "Target version for explicit version bumps."
      },
      {
        "name": "EnumVersionRef",
        "datatype": "string",
        "type": "relationship",
        "nullable": true,
        "Description": "FK for enum-related ops (EnumVersionBump, CoerceToEnum).",
