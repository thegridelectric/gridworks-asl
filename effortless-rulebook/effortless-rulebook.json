  "TypeUpgrades": {
    "Description": "One row per ordered version pair (N, N+1) for a given type. Mirrors src/sema/runtime/types/old_versions/<type>_<NNN>.py.upgrade() methods.",
    "schema": [
      {
        "name": "Name",
        "datatype": "string",
