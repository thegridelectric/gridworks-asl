        "RelatedTo": "Projections"
      },
      {
        "name": "RawScript",
        "datatype": "string",
        "type": "raw",
        "nullable": true,
        "Description": "Per-op Python escape hatch for Custom ops. Snippet runs in scope of `self` and `data` dict."
      },
      {
        "name": "Description",
        "datatype": "string",
        "type": "raw",
        "nullable": true,
        "Description": "Optional op-level description."
      }
    ],
    "data": []
  },
