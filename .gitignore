seed_request.yaml
# Per-consumer snapshot build tooling — lives in the consumer repo, not sema
# (e.g. build_gnr_snapshot.sh + gnr_seed_request.yaml in grid-node-registry);
# when run from a sema checkout it leaves these stray artifacts behind.
*_seed_request.yaml
build_*_snapshot.sh
# Python-generated files
__pycache__/
*.py[oc]
*.DS_Store

build/
dist/
wheels/
*.egg-info
scratch.*
# Virtual environments
.venv
.ssotme
output/


*.zfs
code_gen/GridworksCore/SMQL/*

.vscode
effortless.env

# start.sh runtime artifacts
.logs/

# Claude Code worktree clones (each carries its own .git/)
.claude/worktrees/

# App-level secrets (per-process .env, magic-links tenant record).
# Tracked example/config lives in .env.example next to each .env.
app/**/.env
.env
.secrets/

**/node_modules/**/*
